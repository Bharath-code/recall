[0.680, "o", "\r\n  ⚡ Recall — Your terminal remembers what you forget.\r\n\r\n"]
[1.009, "o", "  $ recall init --auto\r\n"]
[1.598, "o", "\r\n   Welcome to Recall\r\n  Your terminal remembers what you forget.\r\n\r\n"]
[0.000, "o", "  ──────────────────────────────────────────────────\r\n\r\n  ──────────────────────────────────────────────────\r\n\r\n  Step 1/4 — Database\r\n"]
