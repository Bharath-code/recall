[0.005, "o", "   Shell hook installed /var/folders/7j/qbtvlct579jc5fhsspf9z_k00000gn/T/tmp.4NVyqa9Jj4/.zshrc\r\n    Run: source /var/folders/7j/qbtvlct579jc5fhsspf9z_k00000gn/T/tmp.4NVyqa9Jj4/.zshrc\r\n\r\n  ──────────────────────────────────────────────────\r\n\r\n  Step 3/4 — Import History\r\n"]
[0.203, "o", "\r\n  ──────────────────────────────────────────────────\r\n\r\n  Step 4/4 — Tool Inventory\r\n"]
[2.436, "o", "\r\n  ──────────────────────────────────────────────────\r\n\r\n   Recall is ready.\r\n\r\n  Quick commands:\r\n    recall search <query> — Find past commands\r\n    recall recent          — Last 20 commands\r\n    recall project         — Current repo context\r\n    recall doctor          — Check installation\r\n    cd into a git repo for a brief project hint (once per 5 min).\r\n\r\n  Advanced commands:\r\n    recall ask \"<question>\" — AI-powered semantic search\r\n    recall fix             — Show fixes for recent errors\r\n    recall forgotten-tools — Find installed but unused tools\r\n    recall digest          — Weekly terminal activity summary\r\n\r\n   All data stays on your machine. Nothing is phoned home.\r\n\r\n"]
[0.010, "o", "  ──────────────────────────────────────────────────\r\n\r\n   Did you know?\r\n\r\n    You have eza installed but still use `ls`\r\n    color output + git integration\r\n"]
[0.000, "o", "\r\n  ──────────────────────────────────────────────────\r\n\r\n   Try it out!\r\n"]
[0.000, "o", "\r\n  Run a few commands in your terminal, then:\r\n"]
[0.000, "o", "    recall recent          — See what you ran\r\n    recall search docker    — Find that command from last week\r\n    recall project         — Get repo context\r\n\r\n"]
[0.640, "o", "\r\n  $ recall doctor\r\n"]
[0.100, "o", " recall doctor\r\n──────────────────────────────────────────────────\r\n\r\n\r\nInstallation\r\n──────────────────────────────────────────────────\r\n"]
