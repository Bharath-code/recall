---
// Theme toggle component — toggles .dark class on <html>
// Styles match the floating navbar pill aesthetic
---

<button
  id="theme-toggle"
  class="relative inline-flex items-center justify-center min-h-9 min-w-9 p-2 rounded-full text-dust hover:text-cloud hover:bg-slate/40 transition-[color,background-color] duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] active:scale-[0.96]"
  aria-label="Toggle theme"
  title="Toggle theme"
>
  <!-- Sun icon (shown in dark mode, hidden in light) -->
  <svg
    id="theme-sun"
    class="absolute w-4 h-4 opacity-0 scale-50 transition-[opacity,transform] duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="5" />
    <line x1="12" y1="1" x2="12" y2="3" />
    <line x1="12" y1="21" x2="12" y2="23" />
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
    <line x1="1" y1="12" x2="3" y2="12" />
    <line x1="21" y1="12" x2="23" y2="12" />
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
  </svg>

  <!-- Moon icon (shown in light mode, hidden in dark) -->
  <svg
    id="theme-moon"
    class="absolute w-4 h-4 opacity-0 scale-50 transition-[opacity,transform] duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
</button>

<script>
  const btn = document.getElementById('theme-toggle');
  const sun = document.getElementById('theme-sun');
  const moon = document.getElementById('theme-moon');
  const html = document.documentElement;

  function setIcons(isDark) {
    if (isDark) {
      sun.style.opacity = '1';
      sun.style.transform = 'scale(1)';
      moon.style.opacity = '0';
      moon.style.transform = 'scale(0.5)';
    } else {
      sun.style.opacity = '0';
      sun.style.transform = 'scale(0.5)';
      moon.style.opacity = '1';
      moon.style.transform = 'scale(1)';
    }
  }

  // Init icons based on current class
  setIcons(html.classList.contains('dark'));

  btn.addEventListener('click', () => {
    const isDark = html.classList.toggle('dark');
    setIcons(isDark);
    localStorage.setItem('recall-theme', isDark ? 'dark' : 'light');
  });
</script>
