---
import Terminal from './Terminal.astro';
import EmailForm from './EmailForm.astro';

const terminalLines = [
  '⎯⎯⎯⎯ ⎅ recall ⎯ recall ⎯ recall ⎯⎯⎯⎯',
  '',
  'You: how do I deploy this repo?',
  '',
  'Claude Code: [calls recall_search("deploy")]',
  '  → docker compose -f docker.prod.yml up -d',
  '    ran 2d ago in this repo · exit 0 · 4.1s',
  '  That was your last successful deploy.',
  '',
  '$ recall recent --limit 3',
  '  bun test                               ~/api             2m ago  ✓  1.2s',
  '  git push origin fix/auth               ~/api             5m ago  ✗ 1  3.1s',
  '  npm install --legacy-peer-deps         ~/api            12m ago  ✓  4.5s',
  '',
  '$ recall search "docker" --failed-only',
  '  docker compose up -d postgres          ~/api             3d ago  ✗ 1  2.4s',
  '  → fix: docker compose pull             (auto-learned)',
  '',
  '$ recall session --limit 2',
  '  Session  fix/auth  ·  8 commands  ·  12m  ·  2h ago',
  '    1.  git checkout -b fix/auth           ~/api    2h ago  ✓  150ms',
  '    2.  npm install                        ~/api    2h ago  ✗ 1  3.0s',
  '    3.  npm install --legacy-peer-deps     ~/api    2h ago  ✓  4.5s',
  '    4.  vim src/auth/login.ts              ~/api    1h ago  ✓  12s',
  '    5.  npm test                           ~/api    1h ago  ✓  34s',
  '    6.  git add src/auth/                  ~/api    1h ago  ✓  80ms',
  '    7.  git commit -m "fix: handle..."     ~/api    1h ago  ✓  120ms',
  '    8.  git push origin fix/auth           ~/api    5m ago  ✗ 1  3.1s',
  '',
  '$ recall project',
  '  ⚡ npm run dev                          (last: 2m ago)',
  '  ⚡ git checkout -b fix/auth             (last: 2h ago)',
  '  ⚡ docker compose up -d postgres        (startup)',
];
---

<section class="relative pt-28 pb-20 px-4 overflow-hidden">
  <!-- Background gradients -->
  <div class="absolute inset-0 bg-gradient-to-br from-ink via-ink to-terminal opacity-60"></div>
  <div class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-cyan/5 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 right-1/4 w-[500px] h-[500px] bg-mint/5 rounded-full blur-3xl"></div>

  <div class="relative max-w-5xl mx-auto">
    <!-- Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate/50 border border-cyan/20 mb-8">
      <span class="w-2 h-2 rounded-full bg-mint animate-pulse"></span>
      <span class="text-sm text-cyan font-mono">MCP server for Claude Code &amp; Cursor. Local-first.</span>
    </div>

    <!-- Headline -->
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold font-mono text-cloud mb-6 leading-[1.1] text-balance">
      Give your AI coding agent
      <span class="block text-transparent bg-clip-text bg-gradient-to-r from-cyan to-mint">
        a memory of how you work.
      </span>
    </h1>

    <!-- Subheadline -->
    <p class="text-lg sm:text-xl text-dust mb-10 max-w-2xl leading-relaxed text-pretty">
      Recall captures every command with context — repo, directory, exit code, duration —
      then exposes it to Claude Code and Cursor over MCP, so your agent answers
      "how do I deploy this?" from what you <span class="text-cyan font-semibold">actually ran</span>,
      not a guess. Your data stays on your machine. Always.
    </p>

    <!-- Email Form -->
    <div class="mb-14">
      <EmailForm />
      <p class="mt-3 text-xs text-dust/70 font-mono">No spam. No account required. Unsubscribe anytime.</p>
    </div>

    <!-- Terminal -->
    <div class="relative">
      <div class="absolute -inset-1 bg-gradient-to-r from-cyan to-mint rounded-2xl blur opacity-20"></div>
      <div class="relative">
        <Terminal lines={terminalLines} />
      </div>
    </div>
  </div>
</section>
