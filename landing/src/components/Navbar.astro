---
import ThemeToggle from './ThemeToggle.astro';

const githubUrl = 'https://github.com/bharath/recall-cli';
const twitterUrl = 'https://twitter.com/recall_cli';
---

<header class="fixed top-0 left-0 right-0 z-50 flex justify-center pointer-events-none">
  <nav class="mt-4 mx-4 w-max px-4 h-14 flex items-center gap-4 bg-[rgba(var(--nav-bg))] backdrop-blur-2xl border border-[rgba(var(--nav-border))] rounded-full shadow-[0_8px_32px_rgba(var(--nav-shadow))] pointer-events-auto transition-[background-color,border-color,box-shadow] duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]">
    <a href="/" class="flex items-center gap-2 group active:scale-[0.96] transition-transform duration-150">
      <span class="text-xl font-mono font-bold text-cyan group-hover:scale-110 transition-transform duration-200 will-change-transform">>_</span>
      <span class="text-base font-mono font-bold text-cloud group-hover:text-cyan transition-colors duration-200">RECALL</span>
    </a>
    <div class="flex items-center gap-1">
      <a
        href="#features"
        class="hidden sm:inline-flex items-center justify-center min-h-9 min-w-9 px-3 text-dust hover:text-cyan transition-colors duration-200 text-sm font-mono"
      >
        Features
      </a>
      <a
        href={githubUrl}
        class="inline-flex items-center justify-center min-h-9 min-w-9 px-3 text-dust hover:text-cyan transition-colors duration-200 text-sm font-mono"
      >
        GitHub
      </a>
      <a
        href={twitterUrl}
        class="inline-flex items-center justify-center min-h-9 min-w-9 px-3 text-dust hover:text-cyan transition-colors duration-200 text-sm font-mono"
      >
        Twitter
      </a>
    </div>
    <div class="w-px h-5 bg-dust/20"></div>
    <ThemeToggle />
  </nav>
</header>
