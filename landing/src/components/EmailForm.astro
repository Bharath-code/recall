---
const formspreeEndpoint = import.meta.env.FORMSPREE_ENDPOINT || 'https://formspree.io/f/YOUR_FORM_ID';
---

<form
  action={formspreeEndpoint}
  method="POST"
  class="flex flex-col sm:flex-row gap-4 max-w-lg"
>
  <div class="flex-1 relative">
    <input
      type="email"
      name="email"
      placeholder="your@email.com"
      required
      class="w-full px-5 py-4 bg-slate/50 border border-slate/30 rounded-xl text-cloud placeholder-dust/50 font-mono text-sm focus:outline-none focus:border-cyan focus:ring-2 focus:ring-cyan/20 transition-[border-color,box-shadow] duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
    />
  </div>
  <button
    type="submit"
    class="px-8 py-4 bg-gradient-to-r from-cyan to-mint text-ink font-mono font-semibold text-sm rounded-xl hover:shadow-[0_8px_24px_-4px_rgba(0,217,255,0.3)] transition-[transform,box-shadow] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-0.5 active:scale-[0.96] will-change-transform"
  >
    Get Early Access →
  </button>
</form>
